<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.vstu.compprehension</groupId>
    <artifactId>compph-toolchain-server</artifactId>
    <version>0.1.1</version>
    <packaging>jar</packaging>

    <name>CompPrehension Toolchain Server</name>
    <description>
        JSON-RPC HTTP server exposing the CompPrehension command-line toolchains
        (its_DomainModel, its_Reasoner, meaning_tree) as long-running in-process services.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kotlin.version>2.3.21</kotlin.version>
        <kotlin.code.style>official</kotlin.code.style>
        <kotlin.compiler.jvmTarget>21</kotlin.compiler.jvmTarget>
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Versions of the wrapped CompPrehension toolchains (resolved from ~/.m2 or jitpack). -->
        <its.domainmodel.version>3.0.0-rc.8</its.domainmodel.version>
        <its.reasoner.version>3.0.0-rc.9</its.reasoner.version>
        <meaningtree.version>1.0-SNAPSHOT</meaningtree.version>

        <javalin.version>6.7.0</javalin.version>
        <jackson.version>2.18.2</jackson.version>
        <slf4j.version>2.0.16</slf4j.version>

        <main.class>org.vstu.compprehension.toolchain.ServerMainKt</main.class>
    </properties>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo1.maven.org/maven2/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- its_DomainModel pulls several commons-lang3 versions transitively (opencsv, Jena), which
                 breaks requireUpperBoundDeps. Shade excludes them anyway in favour of the copy bundled in
                 meaning_tree's application.jar, so pin compile-time resolution to that same version. -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.20.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Kotlin runtime -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
            <version>${kotlin.version}</version>
        </dependency>

        <!-- Wrapped CompPrehension toolchains, called in-process -->
        <dependency>
            <groupId>com.github.CompPrehension</groupId>
            <artifactId>its_DomainModel</artifactId>
            <version>${its.domainmodel.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.CompPrehension</groupId>
            <artifactId>its_Reasoner</artifactId>
            <version>${its.reasoner.version}</version>
        </dependency>
        <!-- meaning_tree's own fat/shaded jar: java/python/cpp-language, Jena, commons-lang3/text, gson and
             tree-sitter are already merged into its bytecode, but its published POM still lists all of that
             as ordinary transitive dependencies. We drop them all below (see the shade artifactSet excludes)
             so a consuming build never pulls a second, differently versioned copy on top of the embedded one. -->
        <dependency>
            <groupId>org.vstu.meaningtree</groupId>
            <artifactId>application</artifactId>
            <version>${meaningtree.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- HTTP layer -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>${javalin.version}</version>
        </dependency>

        <!-- JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Logging backend -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <version>${kotlin.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>${kotlin.compiler.jvmTarget}</jvmTarget>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-dependency-convergence</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireUpperBoundDeps/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- org.vstu.meaningtree:application (see its <exclusions> above) already bundles
                                 self-consistent copies of these libraries, built and tested together by
                                 meaning_tree's own release. its_DomainModel separately pulls older/different
                                 versions of the same groupIds (Jena 4.6.1 vs the embedded 5.6.0, commons-lang3
                                 3.12.0 vs the embedded 3.20.0 that commons-text 1.15.0's StringEscapeUtils
                                 needs). Without these excludes, shade keeps an arbitrary mix of both versions'
                                 classes per groupId and the mismatch surfaces as NoSuchMethodError at runtime
                                 (e.g. Jena's Assembler.general(), or commons-lang3's Range.of(Comparable,
                                 Comparable)) - or worse, a self-consistent-but-stale pair that happens not to
                                 crash on whatever path you tested. Pinning exact versions instead would work
                                 too, but would silently go stale the next time application.jar's own bundled
                                 versions move; excluding the competing standalone copies stays correct
                                 automatically as long as application.jar remains self-contained. -->
                            <artifactSet>
                                <excludes>
                                    <exclude>org.apache.jena:*</exclude>
                                    <exclude>org.apache.commons:commons-lang3</exclude>
                                    <exclude>org.apache.commons:commons-text</exclude>
                                </excludes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
